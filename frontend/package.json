{
  "name": "numen-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm run test:components && npm run build",
    "preview": "vite preview",
    "test:components": "vite build --ssr tests/component-states.tsx --outDir .test-dist --emptyOutDir && node .test-dist/component-states.js"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
