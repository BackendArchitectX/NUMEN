# NUMEN local runtime. `start` creates .env automatically and replaces the password.
POSTGRES_DB=numen
POSTGRES_USER=numen
POSTGRES_PASSWORD=GENERATED_ON_FIRST_START

# Host ports are loopback-only in Docker Compose.
NUMEN_WEB_PORT=5173
NUMEN_API_PORT=8080

# Data collection guardrails.
NUMEN_HTTP_FETCH_ENABLED=true
NUMEN_MAX_FETCH_URLS=8
NUMEN_MAX_FETCH_ATTEMPTS=2
NUMEN_RETRY_BASE_DELAY_MS=250
NUMEN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
